// =============================================================================
// Jashore Blood Network — Prisma Schema
// =============================================================================
// Source of truth for the database schema. The NestJS API uses Prisma Client
// for typed database access; raw SQL is reserved for migrations, RLS policies,
// and partial indexes that Prisma's DSL cannot express.
//
// Schema conventions:
//   - All PKs are UUID, generated by the database via `default(dbgenerated(...))`
//     to avoid round-tripping UUID generation through the application.
//   - All tables have `created_at` and `updated_at` (except for append-only
//     tables: `consent_records` and `audit_logs` have only `created_at`/`acted_at`).
//   - Soft-delete columns (`deleted_at`) exist on tables that own user-supplied
//     data: profiles, donor_profiles, blood_requests, request_responses,
//     hospitals, blood_banks, notifications, localities.
//   - RLS is enabled on every table containing personal data (see migration
//     20261026000001_rls_policies). Reference tables (districts, upazilas) are
//     publicly readable without RLS.
//   - The `service-role` Supabase key BYPASSES RLS — see docs/MIGRATION_GUIDE.md
//     for the runtime enforcement model.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")     // pooler URL (port 6543, ?pgbouncer=true)
  directUrl = env("DIRECT_URL")        // direct URL (port 5432) for migrations
}

// =============================================================================
// ENUMS
// =============================================================================

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Role {
  REGISTERED_USER
  DONOR
  VOLUNTEER_COORDINATOR
  HOSPITAL_REPRESENTATIVE
  MODERATOR
  DISTRICT_ADMINISTRATOR
  SUPER_ADMINISTRATOR
}

enum DonorVisibility {
  LISTED   // visible in search
  UNLISTED // hidden from search, can still respond to direct requests
  HIDDEN   // only visible to admins
}

enum ContactPreference {
  IN_APP_ONLY
  IN_APP_AND_PHONE
  IN_APP_AND_EMAIL
}

enum RequestStatus {
  PENDING
  VERIFIED
  SEARCHING
  DONOR_RESPONDED
  ARRANGED
  COMPLETED
  CANCELLED
  EXPIRED
  REJECTED
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  CONFIRMED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum FacilityType {
  HOSPITAL
  BLOOD_BANK
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationType {
  REQUEST_MATCH
  RESPONSE_RECEIVED
  REQUEST_VERIFIED
  REQUEST_ARRANGED
  REQUEST_COMPLETED
  REQUEST_CANCELLED
  ABUSE_REPORT_UPDATE
  SYSTEM
}

enum ConsentType {
  DONOR_DISCOVERABILITY
  NOTIFICATION_IN_APP
  NOTIFICATION_EMAIL
  NOTIFICATION_SMS
  DATA_PROCESSING
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

enum AbuseReportStatus {
  PENDING
  REVIEWING
  ACTIONED
  DISMISSED
}

enum AbuseReportTargetType {
  PROFILE
  DONOR_PROFILE
  BLOOD_REQUEST
  REQUEST_RESPONSE
  HOSPITAL
  BLOOD_BANK
  NOTIFICATION
}

// =============================================================================
// PROFILES & ROLES
// =============================================================================

model Profile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String   @unique @db.VarChar(20) // E.164 format, e.g. +8801712345678
  email      String?  @unique @db.VarChar(255)
  fullName   String   @map("full_name") @db.VarChar(120)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  roles                     UserRole[]       @relation("RoleOwner")
  donorProfile              DonorProfile?
  bloodRequests             BloodRequest[]   @relation("RequesterProfile")
  requestResponses          RequestResponse[]
  notifications             Notification[]
  notificationPreferences   NotificationPreference?
  consentRecords            ConsentRecord[]  @relation("ConsentSubject")
  consentActions            ConsentRecord[]  @relation("ConsentActor")
  abuseReportsFiled         AbuseReport[]    @relation("AbuseReporter")
  abuseReportsReviewed      AbuseReport[]    @relation("AbuseReviewer")
  auditLogs                 AuditLog[]       @relation("AuditActor")
  hospitalsRepresented      Hospital[]
  localitiesApproved        Locality[]
  requestsVerified          BloodRequest[]   @relation("RequestVerifier")
  rolesGranted              UserRole[]       @relation("RoleGrantedBy")
  facilityVerifications     FacilityVerification[]

  @@map("profiles")
  @@index([phone])
  @@index([email])
  @@index([isActive, deletedAt])
}

model UserRole {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String    @map("profile_id") @db.Uuid
  role       Role
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by") @db.Uuid

  profile         Profile   @relation("RoleOwner", fields: [profileId], references: [id], onDelete: Cascade)
  grantedByProfile Profile? @relation("RoleGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([profileId, role], map: "user_roles_profile_role_active_unique")
  @@map("user_roles")
  @@index([profileId])
  @@index([role])
  @@index([revokedAt])
}

// =============================================================================
// LOCATION REFERENCE DATA
// =============================================================================

model District {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(80)
  country   String   @default("Bangladesh") @db.VarChar(80)
  code      String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  upazilas Upazila[]

  @@unique([name, country], map: "districts_name_country_unique")
  @@map("districts")
  @@index([country])
}

model Upazila {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  districtId         String    @map("district_id") @db.Uuid
  name               String    @db.VarChar(80)
  code               String?   @db.VarChar(20)
  headquartersLat    Decimal?  @map("headquarters_lat") @db.Decimal(9, 6)
  headquartersLng    Decimal?  @map("headquarters_lng") @db.Decimal(9, 6)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  district           District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  localities         Locality[]
  donorProfiles      DonorProfile[]
  bloodRequests      BloodRequest[]
  hospitals          Hospital[]
  bloodBanks         BloodBank[]

  @@unique([districtId, name], map: "upazilas_district_name_unique")
  @@map("upazilas")
  @@index([districtId])
}

model Locality {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  upazilaId   String    @map("upazila_id") @db.Uuid
  name        String    @db.VarChar(120)
  isApproved  Boolean   @default(false) @map("is_approved")
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  upazila     Upazila   @relation(fields: [upazilaId], references: [id], onDelete: Cascade)
  approver    Profile?  @relation(fields: [approvedBy], references: [id], onDelete: SetNull)
  donorProfiles DonorProfile[]

  @@unique([upazilaId, name], map: "localities_upazila_name_unique")
  @@map("localities")
  @@index([upazilaId, isApproved])
}

// =============================================================================
// DONOR PROFILES
// =============================================================================

model DonorProfile {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId                String            @unique @map("profile_id") @db.Uuid
  bloodGroup               BloodGroup        @map("blood_group")
  upazilaId                String            @map("upazila_id") @db.Uuid
  localityId               String?           @map("locality_id") @db.Uuid
  lastDonationAt           DateTime?         @map("last_donation_at") @db.Date
  isAvailable              Boolean           @default(true) @map("is_available")
  availabilityConfirmedAt  DateTime          @default(now()) @map("availability_confirmed_at")
  visibility               DonorVisibility   @default(LISTED)
  contactPreference        ContactPreference @default(IN_APP_ONLY) @map("contact_preference")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  deletedAt                DateTime?         @map("deleted_at")

  profile                  Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  upazila                  Upazila           @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  locality                 Locality?         @relation(fields: [localityId], references: [id], onDelete: SetNull)

  @@map("donor_profiles")
  @@index([bloodGroup, upazilaId, isAvailable, deletedAt], map: "donor_profiles_search_idx")
  @@index([availabilityConfirmedAt], map: "donor_profiles_stale_availability_idx")
  @@index([profileId, deletedAt])
}

// =============================================================================
// BLOOD REQUESTS & RESPONSES
// =============================================================================

model BloodRequest {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId       String        @map("requester_id") @db.Uuid
  bloodGroup        BloodGroup    @map("blood_group")
  unitsRequested    Int           @map("units_requested") @db.SmallInt
  upazilaId         String        @map("upazila_id") @db.Uuid
  hospitalId        String?       @map("hospital_id") @db.Uuid
  requiredBy        DateTime      @map("required_by")
  status            RequestStatus @default(PENDING)
  expiresAt         DateTime      @map("expires_at")
  verificationNote  String?       @map("verification_note") @db.Text
  verifiedBy        String?       @map("verified_by") @db.Uuid
  verifiedAt        DateTime?     @map("verified_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancellationReason String?      @map("cancellation_reason") @db.Text
  contactNote       String?       @map("contact_note") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  requester         Profile       @relation("RequesterProfile", fields: [requesterId], references: [id], onDelete: Cascade)
  upazila           Upazila       @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  hospital          Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  verifier          Profile?      @relation("RequestVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  responses         RequestResponse[]

  @@map("blood_requests")
  @@index([status, bloodGroup, upazilaId], map: "blood_requests_donor_match_idx")
  @@index([requesterId, createdAt(sort: Desc)], map: "blood_requests_my_requests_idx")
  @@index([status, expiresAt], map: "blood_requests_expiring_idx")
  @@index([upazilaId, status])
}

model RequestResponse {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId    String         @map("request_id") @db.Uuid
  donorId      String         @map("donor_id") @db.Uuid
  status       ResponseStatus @default(PENDING)
  respondedAt  DateTime       @default(now()) @map("responded_at")
  withdrawnAt  DateTime?      @map("withdrawn_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  note         String?        @db.Text

  request      BloodRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor        Profile        @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorId], map: "request_responses_request_donor_unique")
  @@map("request_responses")
  @@index([donorId, status], map: "request_responses_my_responses_idx")
  @@index([requestId, status])
}

// =============================================================================
// HOSPITALS, BLOOD BANKS, VERIFICATIONS
// =============================================================================

model Hospital {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String             @db.VarChar(180)
  upazilaId          String             @map("upazila_id") @db.Uuid
  address            String             @db.Text
  phone              String?            @db.VarChar(30)
  operatingHours     String?            @map("operating_hours") @db.Text
  servicesOffered    String?            @map("services_offered") @db.Text
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  representedBy      String?            @map("represented_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  upazila            Upazila            @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  representative     Profile?           @relation(fields: [representedBy], references: [id], onDelete: SetNull)
  bloodRequests      BloodRequest[]
  bloodBanks         BloodBank[]
  verifications      FacilityVerification[] @relation("HospitalVerifications")

  @@map("hospitals")
  @@index([upazilaId, verificationStatus])
  @@index([verificationStatus])
}

model BloodBank {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId         String?            @map("hospital_id") @db.Uuid
  name               String             @db.VarChar(180)
  upazilaId          String             @map("upazila_id") @db.Uuid
  address            String             @db.Text
  phone              String?            @db.VarChar(30)
  operatingHours     String?            @map("operating_hours") @db.Text
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  hospital           Hospital?          @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  upazila            Upazila            @relation(fields: [upazilaId], references: [id], onDelete: Restrict)
  verifications      FacilityVerification[] @relation("BloodBankVerifications")

  @@map("blood_banks")
  @@index([upazilaId, verificationStatus])
  @@index([hospitalId])
}

model FacilityVerification {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityType    FacilityType      @map("facility_type")
  hospitalId      String?           @map("hospital_id") @db.Uuid
  bloodBankId     String?           @map("blood_bank_id") @db.Uuid
  verifiedBy      String            @map("verified_by") @db.Uuid
  status          VerificationStatus
  evidenceSummary String            @map("evidence_summary") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")

  hospital        Hospital?         @relation("HospitalVerifications", fields: [hospitalId], references: [id], onDelete: Cascade)
  bloodBank       BloodBank?        @relation("BloodBankVerifications", fields: [bloodBankId], references: [id], onDelete: Cascade)
  verifier        Profile           @relation(fields: [verifiedBy], references: [id], onDelete: Restrict)

  @@map("facility_verifications")
  @@index([facilityType, status, createdAt(sort: Desc)])
  @@index([hospitalId])
  @@index([bloodBankId])
}

// =============================================================================
// NOTIFICATIONS & PREFERENCES
// =============================================================================

model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId  String           @map("recipient_id") @db.Uuid
  type         NotificationType
  channel      NotificationChannel @default(IN_APP)
  title        String           @db.VarChar(180)
  body         String           @db.Text
  isRead       Boolean          @default(false) @map("is_read")
  readAt       DateTime?        @map("read_at")
  metadata     Json             @default("{}")
  relatedType  String?          @map("related_type") @db.VarChar(60)
  relatedId    String?          @map("related_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  recipient    Profile          @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([recipientId, isRead, createdAt(sort: Desc)], map: "notifications_inbox_idx")
  @@index([recipientId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId       String   @unique @map("profile_id") @db.Uuid
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  smsEnabled      Boolean  @default(false) @map("sms_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// =============================================================================
// CONSENT RECORDS (append-only)
// =============================================================================

model ConsentRecord {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String       @map("profile_id") @db.Uuid
  consentType  ConsentType  @map("consent_type")
  action       ConsentAction
  actorId      String       @map("actor_id") @db.Uuid
  ipAddress    String?      @map("ip_address") @db.VarChar(45)
  userAgent    String?      @map("user_agent") @db.Text
  metadata     Json         @default("{}")
  actedAt      DateTime     @default(now()) @map("acted_at")

  profile      Profile      @relation("ConsentSubject", fields: [profileId], references: [id], onDelete: Cascade)
  actor        Profile      @relation("ConsentActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@map("consent_records")
  @@index([profileId, consentType, actedAt(sort: Desc)])
  @@index([actorId, actedAt(sort: Desc)])
}

// =============================================================================
// ABUSE REPORTS
// =============================================================================

model AbuseReport {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId    String?                @map("reporter_id") @db.Uuid
  targetType    AbuseReportTargetType  @map("target_type")
  targetId      String                 @map("target_id") @db.Uuid
  reason        String                 @db.Text
  description   String?                @db.Text
  status        AbuseReportStatus      @default(PENDING)
  reviewedBy    String?                @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?              @map("reviewed_at")
  reviewNote    String?                @map("review_note") @db.Text
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  reporter      Profile?               @relation("AbuseReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewer      Profile?               @relation("AbuseReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("abuse_reports")
  @@index([status, createdAt], map: "abuse_reports_queue_idx")
  @@index([targetType, targetId])
  @@index([reporterId, createdAt(sort: Desc)])
}

// =============================================================================
// AUDIT LOGS (append-only)
// =============================================================================

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String   @map("target_type") @db.VarChar(60)
  targetId    String?  @map("target_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  actor       Profile? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([actorId, createdAt(sort: Desc)], map: "audit_logs_actor_idx")
  @@index([targetType, targetId, createdAt(sort: Desc)], map: "audit_logs_target_idx")
  @@index([action, createdAt(sort: Desc)])
}
