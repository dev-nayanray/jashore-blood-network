    PROFILES {
        uuid id PK
        text phone UK
        text email
        text full_name
        timestamptz created_at
        timestamptz deleted_at
    }
    USER_ROLES {
        uuid id PK
        uuid profile_id FK
        enum role
        uuid granted_by FK
        timestamptz granted_at
    }
    DONOR_PROFILES {
        uuid id PK
        uuid profile_id FK
        enum blood_group
        uuid upazila_id FK
        uuid locality_id FK
        date last_donation_at
        boolean is_available
        timestamptz availability_confirmed_at
        enum visibility
    }
    BLOOD_REQUESTS {
        uuid id PK
        uuid requester_id FK
        enum blood_group
        smallint units_requested
        uuid upazila_id FK
        uuid hospital_id FK
        timestamptz required_by
        enum status
        timestamptz expires_at
    }
    REQUEST_RESPONSES {
        uuid id PK
        uuid request_id FK
        uuid donor_id FK
        enum status
        timestamptz responded_at
    }
    HOSPITALS {
        uuid id PK
        text name
        uuid upazila_id FK
        enum verification_status
    }
