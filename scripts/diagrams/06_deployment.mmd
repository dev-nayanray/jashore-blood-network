%%{init: {'theme':'base','themeVariables':{'fontFamily':'FreeSerif, serif','fontSize':'14px','primaryColor':'#edebe7','primaryTextColor':'#20201d','primaryBorderColor':'#5e563d','lineColor':'#8b7638','clusterBkg':'#f7f7f6','clusterBorder':'#5e563d'}}}%%
flowchart TB
    classDef gh fill:#20201d,stroke:#917520,stroke-width:1.5px,color:#f7f7f6
    classDef vercel fill:#edebe7,stroke:#5e563d,stroke-width:1.5px,color:#20201d
    classDef render fill:#f0efeb,stroke:#5e563d,stroke-width:1.5px,color:#20201d
    classDef supa fill:#f4f3f1,stroke:#5e563d,stroke-width:1.5px,color:#20201d
    classDef ci fill:#edebe7,stroke:#8b7638,stroke-width:1.2px,stroke-dasharray:4 3,color:#20201d

    subgraph GH["GitHub Repository"]
        REPO[Main Branch<br/>+ Feature Branches]:::gh
        PR[Pull Requests<br/>Required Reviews]:::gh
    end

    subgraph CI["GitHub Actions CI"]
        LINT[Lint + Type Check]:::ci
        TEST[Unit + Integration Tests]:::ci
        BUILD[Build Both Apps]:::ci
        SEC[Dependency Scan<br/>CodeQL]:::ci
    end

    subgraph VERCEL["Vercel — Frontend"]
        PREVIEW_V[Preview Deploy<br/>per PR]:::vercel
        PROD_V[Production Deploy<br/>on merge to main]:::vercel
    end

    subgraph RENDER["Render — Backend API"]
        PREVIEW_R[Preview Service<br/>per PR]:::render
        PROD_R[Production Service<br/>on merge to main]:::render
        HEALTH[Health Check<br/>/health endpoint]:::render
    end

    subgraph SUPABASE["Supabase"]
        DB_PROD[(Production DB<br/>500MB free tier)]:::supa
        DB_DEV[(Dev DB<br/>separate project)]:::supa
        AUTH_PROD[Auth Production]:::supa
        AUTH_DEV[Auth Dev]:::supa
    end

    REPO --> PR
    PR --> LINT
    PR --> TEST
    PR --> BUILD
    PR --> SEC
    LINT --> PREVIEW_V
    LINT --> PREVIEW_R
    BUILD --> PROD_V
    BUILD --> PROD_R
    PROD_V --> DB_PROD
    PROD_R --> DB_PROD
    PROD_R --> AUTH_PROD
    PREVIEW_V --> DB_DEV
    PREVIEW_R --> DB_DEV
    PREVIEW_R --> AUTH_DEV
    PROD_R --> HEALTH
