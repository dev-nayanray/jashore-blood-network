# =============================================================================
# Jashore Blood Network — Environment Variables (EXAMPLE ONLY)
# =============================================================================
# Copy this file to `.env` in the same directory and replace placeholder
# values with real credentials. NEVER commit the `.env` file.
# Real credentials must be configured in the Vercel / Render / Supabase
# dashboards, not in the repository.
# =============================================================================

# ---------- Frontend (apps/web, deployed on Vercel) ----------
# Public URL of the NestJS API. The web app calls this from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase public URL (safe to expose — used by the browser for auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (safe to expose — RLS policies enforce access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------- Backend (apps/api, deployed on Render) ----------
# Server-only. NEVER prefixed with NEXT_PUBLIC_. NEVER shipped to the browser.

# Connection pooler URL (port 6543) — used at runtime by Prisma Client.
# Must include ?pgbouncer=true&connection_limit=1 for Supabase's PgBouncer.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Direct URL (port 5432) — used by Prisma migrate CLI and the seed script.
# Bypasses the pooler because migrations need a session-level connection.
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key — BYPASSES Row Level Security.
# Store ONLY in the backend environment (Render). NEVER in frontend code.
# NEVER in any NEXT_PUBLIC_ variable. NEVER committed to the repository.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase JWT secret — used by NestJS to verify Supabase Auth tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cookie domain for the session cookie (omit for localhost)
JWT_COOKIE_DOMAIN=

# Comma-separated list of allowed CORS origins.
# NEVER use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (transactional)
EMAIL_FROM=noreply@jashore-blood-network.org
RESEND_API_KEY=re_your_resend_api_key

# Runtime
NODE_ENV=development
PORT=3001

# Rate limit store (optional during pilot — defaults to in-memory)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# ---- Auth mode (optional) ----
# 'supabase' = real Supabase project + SMS provider (production)
# 'local'    = built-in free OTP: no SMS needed, code is shown on screen (demo)
# Unset = auto (uses Supabase when SUPABASE_* values are real, otherwise local)
# AUTH_MODE=local

# ---- Demo data seeding (optional) ----
# 'false' disables seeding demo data into an empty database on API boot.
# DEMO_SEED=false

# ---- Admin password login (optional) ----
# Password for the admin-only /auth/login endpoint (username: 'admin').
# Defaults to 'admin123' when unset — change it before any real use.
# ADMIN_PASSWORD=change-me
